{
  "name": "studyvault-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run api:generate",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run api:generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "openapi-typescript ../backend/api/openapi.yaml -o src/api/schema.d.ts",
    "test": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:proxy": "node --test checks/proxy.test.mjs",
    "package:submission": "npm run build && vite build --mode submission && node scripts/package-submission.mjs",
    "test:submission": "npm run package:submission && playwright test tests/submission.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@tiptap/react": "^3.6.0",
    "@tiptap/starter-kit": "^3.6.0",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
