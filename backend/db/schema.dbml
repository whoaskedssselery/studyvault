Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email text [not null, unique]
  password_hash text [not null]
  display_name text [not null]
  role text [not null, default: 'student', note: 'student | moderator; назначает только сервер (cmd/promote)']
  faculty text [note: 'необязательно, до 100 символов']
  email_verified_at timestamptz [note: 'null = почта не подтверждена; до подтверждения нельзя публиковать, комментировать и оценивать']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash text [not null, unique, note: 'sha256, сам токен не храним']
  user_agent text
  expires_at timestamptz [not null]
  revoked_at timestamptz [note: 'null = активен']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }
}

Table subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  title text [not null]
  color text [note: 'hex для UI']
  semester smallint [note: 'null = без семестра']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table notes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [ref: > subjects.id, note: 'null = без предмета']
  title text [not null]
  content jsonb [not null, note: 'документ Tiptap']
  content_text text [not null, default: '', note: 'плоский текст для индекса Meilisearch']
  is_pinned boolean [not null, default: false]
  kind text [not null, default: 'note', note: 'note | cheat_sheet']
  summary text [note: 'краткое описание, до 500 символов']
  semester smallint [note: '1..12']
  status text [not null, default: 'draft', note: 'draft | pending | published | rejected']
  published_at timestamptz [note: 'задан тогда и только тогда, когда status = published']
  views bigint [not null, default: 0]
  library_subject_id uuid [ref: > library_subjects.id, note: 'общий предмет библиотеки']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'soft delete']

  indexes {
    (user_id, updated_at)
    subject_id
    (user_id, `lower(title)`) [note: "поиск заметки по названию при разрешении ссылок"]
    (published_at, id) [note: 'лента библиотеки, только status = published']
    (views, id) [note: 'сортировка по просмотрам, только status = published']
    (updated_at, id) [note: 'очередь проверки, только status = pending']
    library_subject_id [note: 'только status = published']
  }
}

Table tags {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  name text [not null]

  indexes {
    (user_id, name) [unique]
  }
}

Table note_tags {
  note_id uuid [not null, ref: > notes.id]
  tag_id uuid [not null, ref: > tags.id]

  indexes {
    (note_id, tag_id) [pk]
  }
}

Table note_mentions {
  note_id uuid [not null, ref: > notes.id]
  title_key text [not null, note: 'название из [[...]] в нижнем регистре, без подписи после |']

  indexes {
    (note_id, title_key) [pk]
    title_key
  }
}

Table note_links {
  source_note_id uuid [not null, ref: > notes.id, note: 'заметка, где написано [[...]]']
  target_note_id uuid [not null, ref: > notes.id, note: 'заметка, на которую ссылаются']

  indexes {
    (source_note_id, target_note_id) [pk]
    target_note_id
  }
}

Table attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  note_id uuid [ref: > notes.id, note: 'null = не привязан']
  object_key text [not null, unique, note: 'ключ в MinIO']
  file_name text [not null]
  mime_type text [not null]
  size_bytes bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    note_id
    user_id
  }
}

Table library_subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null, note: 'уникально без учёта регистра; ведёт модератор']
  color text [note: '#rrggbb']
  created_at timestamptz [not null, default: `now()`]
}

Table comments {
  id uuid [pk, default: `gen_random_uuid()`]
  note_id uuid [not null, ref: > notes.id]
  user_id uuid [not null, ref: > users.id]
  body text [not null, note: '1..2000 символов']
  created_at timestamptz [not null, default: `now()`]
  edited_at timestamptz [note: 'когда автор последний раз правил комментарий']
  deleted_at timestamptz [note: 'soft delete']

  indexes {
    (note_id, created_at, id) [note: 'только неудалённые']
  }
}

Table note_ratings {
  note_id uuid [not null, ref: > notes.id]
  user_id uuid [not null, ref: > users.id]
  value smallint [not null, note: '1..5']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (note_id, user_id) [pk, note: 'одна оценка на пару']
  }
}

Table moderation_decisions {
  id uuid [pk, default: `gen_random_uuid()`]
  note_id uuid [not null, ref: > notes.id]
  moderator_id uuid [ref: > users.id, note: 'null, если аккаунт модератора удалён: решение остаётся в истории']
  decision text [not null, note: 'approved | rejected | unpublished (снят с публикации)']
  reason text [note: 'обязательна при rejected']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (note_id, created_at)
  }
}

Table note_bookmarks {
  note_id uuid [not null, ref: > notes.id]
  user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (note_id, user_id) [pk]
    (user_id, created_at)
  }
}

Table email_verification_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash text [not null, unique, note: 'sha256 токена из письма, сам токен не хранится']
  expires_at timestamptz [not null, note: '24 часа с момента отправки']
  used_at timestamptz [note: 'ссылка срабатывает один раз']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }
}

Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash text [not null, unique, note: 'sha256 токена из письма, сам токен не хранится']
  expires_at timestamptz [not null, note: 'час с момента запроса']
  used_at timestamptz [note: 'ссылка срабатывает один раз']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }
}
