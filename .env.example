# Скопируйте в .env и поменяйте значения. Реальный .env в git не попадает.

POSTGRES_USER=studyvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyvault
DATABASE_URL=postgres://studyvault:change-me@localhost:5440/studyvault?sslmode=disable

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me-master-key-16plus

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=studyvault
S3_SECRET_KEY=change-me-secret
S3_BUCKET=attachments
# Разрешённые источники прямой загрузки файлов из браузера в RustFS.
S3_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:5175,http://127.0.0.1:5175

JWT_SECRET=change-me-jwt-secret-32-chars-min

# Источники, которым разрешено ходить в API из браузера (фронтенд), через запятую.
# Только явные адреса, без *: API использует cookie.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie с refresh-токеном по умолчанию уходит только по HTTPS (Secure).
# Для локальной разработки по http отключено; в проде это значение нужно убрать или поставить true.
COOKIE_SECURE=false

# Сброс пароля по почте. В разработке письма ловит Mailpit (http://localhost:8025), настройки подставляются сами.
# PASSWORD_RESET_URL: страница фронтенда, куда ведёт ссылка из письма (токен добавляется параметром token).
# В боевом стенде укажите настоящий SMTP: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Подтверждение почты при регистрации: письмо со ссылкой на страницу фронтенда (токен в параметре token). Без подтверждения
# нельзя публиковать материалы, комментировать и ставить оценки. Если не задано, берётся /verify-email на том же сайте,
# что и PASSWORD_RESET_URL. Без настроенной почты (SMTP_HOST) подтверждения нет: новые аккаунты считаются подтверждёнными.
# EMAIL_VERIFY_URL=http://localhost:5173/verify-email

# Пароль демо-аккаунтов для команды seed (модератор и студенты для показа). Только для локальной работы.
SEED_PASSWORD=demo-password-123

# Лог: json (по умолчанию, для сборщиков логов) или text (читать глазами); уровень debug, info, warn, error.
LOG_FORMAT=text
LOG_LEVEL=info
