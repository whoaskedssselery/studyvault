# Скопируйте в .env и поменяйте значения. Реальный .env в git не попадает.

POSTGRES_USER=studyvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyvault
DATABASE_URL=postgres://studyvault:change-me@localhost:5440/studyvault?sslmode=disable

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me-master-key-16plus

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=studyvault
S3_SECRET_KEY=change-me-secret
S3_BUCKET=attachments

JWT_SECRET=change-me-jwt-secret-32-chars-min
